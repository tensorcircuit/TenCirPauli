#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)

if [ -x "$root/.conda/bin/python" ]; then
    python="$root/.conda/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    python=$(command -v python3)
else
    echo "TenCirPauli pre-commit: Python not found; create the project environment first." >&2
    exit 1
fi

benchmark_mode=${TENCIRPAULI_PRE_COMMIT_BENCHMARK:-smoke}
case "$benchmark_mode" in
    smoke|record|skip) ;;
    *)
        echo "TenCirPauli pre-commit: TENCIRPAULI_PRE_COMMIT_BENCHMARK must be smoke, record, or skip." >&2
        exit 1
        ;;
esac

exec "$python" "$root/scripts/check.py" --benchmark "$benchmark_mode"
